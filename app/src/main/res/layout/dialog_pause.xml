<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:paddingBottom="32dp"
    android:background="@color/material_dynamic_neutral10">
    <!-- Đổi chiều rộng thành 320dp và chiều cao thành wrap_content để hộp thoại không bị giãn thô -->

    <TextView
        android:id="@+id/txtTitleDialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Tạm dừng"
        android:textColor="@android:color/holo_green_light"
        android:textSize="50sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!-- Đã thêm constraintEnd_toEndOf và xóa marginStart -->

    <Button
        android:id="@+id/btnResume"
        android:layout_width="226dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:backgroundTint="@android:color/holo_green_light"
        android:text="Tiếp tục"
        android:textColor="@color/black"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtTitleDialog" />
    <!-- Đã thêm constraintEnd_toEndOf và xóa marginStart -->

    <Button
        android:id="@+id/btnBackHome"
        android:layout_width="226dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/material_dynamic_neutral10"
        android:text="Về trang chủ"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnResume" />
    <!-- Đã thêm constraintEnd_toEndOf và xóa marginStart -->

</androidx.constraintlayout.widget.ConstraintLayout>